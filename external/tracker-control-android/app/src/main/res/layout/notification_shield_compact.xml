<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingStart="8dp" android:paddingEnd="4dp" android:paddingTop="4dp" android:paddingBottom="4dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:paddingEnd="6dp">
        <TextView android:id="@+id/notificationTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="1" android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/notificationContent" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="1" android:textColor="?android:attr/textColorSecondary" android:textSize="12sp" />
    </LinearLayout>
    <TextView android:id="@+id/actionPause" android:layout_width="wrap_content" android:layout_height="48dp"
        android:gravity="center" android:minWidth="76dp" android:paddingStart="5dp" android:paddingEnd="5dp"
        android:textColor="?android:attr/colorAccent" android:textSize="12sp" android:textStyle="bold" />
    <TextView android:id="@+id/actionOpen" android:layout_width="wrap_content" android:layout_height="48dp"
        android:gravity="center" android:minWidth="76dp" android:paddingStart="5dp" android:paddingEnd="5dp"
        android:textColor="?android:attr/colorAccent" android:textSize="12sp" android:textStyle="bold" />
</LinearLayout>
